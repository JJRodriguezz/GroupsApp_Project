# ══════════════════════════════════════════════════════════════
#  GroupsApp — Variables de entorno
#  Copia este archivo como .env y completa los valores
#  cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── Frontend (Next.js) — URLs públicas del API ─────────────────
# Misma URL que usas para acceder (NLB / ALB / Ingress)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PRESENCE_WS_URL=http://localhost:4000

# ── Seguridad ──────────────────────────────────────────────────
# JWT_SECRET: Genera un valor seguro con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_KEY_WITH_openssl_rand_hex_32

# ── Base de datos (PostgreSQL) ────────────────────────────────
# Para docker-compose: usa valores que coincidan con POSTGRES_PASSWORD
DB_HOST=postgres-auth
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_MIN_16_CHARS

# ── AWS S3 (media-service) ───────────────────────────────────
# En desarrollo local, deja vacías o usa credenciales de prueba
AWS_ACCESS_KEY_ID=CHANGE_ME_OR_LEAVE_EMPTY_FOR_LOCAL
AWS_SECRET_ACCESS_KEY=CHANGE_ME_OR_LEAVE_EMPTY_FOR_LOCAL
AWS_REGION=us-east-1
S3_BUCKET=CHANGE_ME_YOUR_S3_BUCKET_NAME

# ── Entorno ────────────────────────────────────────────────────
NODE_ENV=development

# ══════════════════════════════════════════════════════════════
#  Siguientes variables: defaults funcionales en docker-compose
#  Modifica solo si quieres conectar a servicios externos
# ══════════════════════════════════════════════════════════════

# SERVICE URLs (para docker-compose, usa estos hosts internos)
AUTH_SERVICE_URL=http://auth-service:3001
USERS_SERVICE_URL=http://users-service:3002
GROUPS_SERVICE_URL=http://groups-service:3003
MEDIA_SERVICE_URL=http://media-service:3004
MESSAGING_SERVICE_URL=http://messaging-service:3005
PRESENCE_SERVICE_URL=http://presence-service:3006

# gRPC URLs (para docker-compose)
USERS_GRPC_URL=users-service:50052
GROUPS_GRPC_URL=groups-service:50053

# Kafka y otros servicios (para docker-compose)
KAFKA_BROKER=kafka:29092
REDIS_URL=redis://redis:6379
CONSUL_URL=http://consul:8500